# ===========================================
# Required Configuration
# ===========================================

# LLM API Configuration
OPENAI_API_KEY=sk-xxx

# Model names (required, no defaults)
OPENAI_CHAT_MODEL=gpt-4o-mini           # Examples: gpt-4o-mini, gpt-4o, qwen3.5-35b-a3b, deepseek-chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Examples: text-embedding-3-small, text-embedding-v4

# ===========================================
# Optional - API Endpoint
# ===========================================

# Leave empty for OpenAI, or set for custom providers:
# OPENAI_BASE_URL=
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Azure: https://your-resource.openai.azure.com/
# Ollama: http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1

# ===========================================
# Optional - LLM Settings
# ===========================================

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false

# ===========================================
# Optional - Scoring Weights
# ===========================================

SCORING_WEIGHT_INDUSTRY_IMPACT=0.4
SCORING_WEIGHT_MILESTONE=0.35
SCORING_WEIGHT_ATTENTION=0.25

# ===========================================
# Optional - Embedding Provider
# ===========================================

EMBEDDING_PROVIDER=openai    # "openai" | "dashscope" | "custom"
EMBEDDING_MAX_BATCH_SIZE=10  # Batch size for embedding APIs

# ===========================================
# Optional - Reranker
# ===========================================

RERANK_PROVIDER=none         # "none" | "dashscope" | "cohere" | "jina"
RERANK_MODEL=gte-rerank
RERANK_API_KEY=              # Falls back to OPENAI_API_KEY if not set
# RERANK_API_URL=            # Override default rerank API URL

# ===========================================
# Optional - Web Search
# ===========================================

WEB_SEARCH_PROVIDER=duckduckgo  # "duckduckgo" | "tavily"
WEB_SEARCH_API_KEY=             # Required for Tavily
WEB_SEARCH_TIMEOUT=30.0
WEB_SEARCH_MIN_INTERVAL=2.0     # Rate limiting (seconds)
WEB_SEARCH_MAX_INTERVAL=4.0
# TAVILY_API_URL=https://api.tavily.com/search  # Override Tavily API URL

# ===========================================
# Optional - Web Extractor
# ===========================================

WEB_EXTRACTOR_TIMEOUT=30.0
WEB_EXTRACTOR_MAX_RETRIES=3
WEB_EXTRACTOR_RETRY_DELAY=1.0
WEB_EXTRACTOR_HOST_LIMIT=2

# ===========================================
# Database (required)
# ===========================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_aggregator

# ===========================================
# LangSmith Tracing (optional)
# ===========================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===========================================
# RAG Configuration (optional)
# ===========================================

RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=400
RAG_VECTOR_WEIGHT=0.6
RAG_FTS_WEIGHT=0.4
RAG_RERANK_TOP_K=10
RAG_FINAL_TOP_K=5

# ===========================================
# Deduplication & Scoring (optional)
# ===========================================

DEDUP_SIMILARITY_THRESHOLD=0.85
SCORE_THRESHOLD=5.0

# ===========================================
# Reflection (optional)
# ===========================================

MAX_REFLECTION_RETRIES=3

# ===========================================
# Concurrency (optional)
# ===========================================

MAX_CONCURRENT_SCORERS=5
MAX_CONCURRENT_WRITERS=3
MAX_CONCURRENT_REFLECTORS=3

# ===========================================
# Deep Search (optional)
# ===========================================

DEEP_SEARCH_MAX_ITERATIONS=5

# ===========================================
# DeepGraph Configuration (optional)
# ===========================================

DEEPGRAPH_ENABLED=true
DEEPGRAPH_BUILDER_ENABLED=true
DEEPGRAPH_MAX_HOPS=2
DEEPGRAPH_EXPANSION_LIMIT=50
DEEPGRAPH_ENTITY_SIMILARITY_THRESHOLD=0.85

# ===========================================
# Server (optional)
# ===========================================

HOST=0.0.0.0
PORT=8000
DEBUG=true

# ===========================================
# CORS Configuration (optional)
# ===========================================

# Comma-separated list of allowed origins for CORS
# Default: http://localhost:3000 (safe for local development)
# For production, specify your actual frontend domain(s)
# Example: CORS_ORIGINS=http://localhost:3000,https://myapp.com
CORS_ORIGINS=http://localhost:3000

# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*